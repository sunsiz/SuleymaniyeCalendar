<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) cloud and device-to-device transfer rules.
     Exclude SharedPreferences to prevent stale alarm/sound settings
     from being restored after uninstall/reinstall. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
