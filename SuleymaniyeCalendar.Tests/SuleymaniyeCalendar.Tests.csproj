<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Reference MAUI packages without build assets -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120">
      <ExcludeAssets>build;buildTransitive</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.120">
      <ExcludeAssets>build;buildTransitive</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SuleymaniyeCalendar\SuleymaniyeCalendar.csproj">
      <ExcludeAssets>build;buildTransitive</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
